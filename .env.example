# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the application (used to construct password reset links).
APP_URL="http://localhost:3000"

# ============================================================================
# EMAIL DELIVERY PROVIDER CONFIGURATION (Choose ONE provider for Password Reset Links)
# Secrets are read strictly on the server and never exposed to the client.
# ============================================================================
RECOVERY_EMAIL_FROM="no-reply@example.com"

# Option 1: Resend (https://resend.com)
RESEND_API_KEY=""

# Option 2: SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=""

# Option 3: Brevo / Sendinblue (https://brevo.com)
BREVO_API_KEY=""

# Option 4: Custom Email Webhook / SMTP Relay Endpoint
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_SECRET=""

# ============================================================================
# SMS DELIVERY PROVIDER CONFIGURATION (Choose ONE provider for Phone OTP Codes)
# Secrets are read strictly on the server and never exposed to the client.
# ============================================================================

# Option 1: Twilio Programmable SMS (https://twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Option 2: Vonage / Nexmo SMS (https://vonage.com)
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_FROM="AH2"

# Option 3: Custom SMS Gateway HTTP Webhook (e.g. VictoryLink / WhySMS / Local Gateway)
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""
SMS_SENDER_ID="AH2"
